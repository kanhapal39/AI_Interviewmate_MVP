# Environment variables for InterviewMate
# Copy to .env and fill values

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here

# Database
DATABASE_URL=postgresql+psycopg2://interviewmate:password@localhost:5432/interviewmate

# Object storage (S3-compatible)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=interviewmate-documents
AWS_ENDPOINT_URL=https://s3.amazonaws.com  # or local minio: http://localhost:9000

# Application
SECRET_KEY=super-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000